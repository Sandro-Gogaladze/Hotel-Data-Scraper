# Copy this file to .env and fill in what you need. Nothing here is required to run
# main.py - every variable is optional for a local run.

# Breakfast-inclusion analysis (analyzers/breakfast.py) and fail_analyzer.py.
# Without it, "Breakfast Included" falls back to a keyword check of the room text.
OPENAI_API_KEY=

# Set to true to run Chromium without a window (CI sets this).
# HEADLESS=false

# Only for sending the report email locally (scheduled/send_report.py). In GitHub
# Actions these come from repository secrets instead.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# REPORT_RECIPIENT=
